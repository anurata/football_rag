      "duration": 3.96
    },
    {
      "text": "すごいいい雰囲気で",
      "start": 1226.48,
      "duration": 5.26
    },
    {
      "text": "なんかサポーターの人にも聞いたけど",
      "start": 1229.46,
      "duration": 3.959
    },
    {
      "text": "久しぶりになんかこれ気持ちいい勝利だね",
