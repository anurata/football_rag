      "duration": 6.78
    },
    {
      "text": "ですよそうだったんですねだから今日",
      "start": 1452.539,
      "duration": 5.901
    },
    {
      "text": "プレミアムにこっちなんだ",
      "start": 1456.02,
      "duration": 5.279
    },
    {
      "text": "とってことはもうメンバー入り近いって",
