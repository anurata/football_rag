      "duration": 3.299
    },
    {
      "text": "みたいな",
      "start": 1233.419,
      "duration": 5.401
    },
    {
      "text": "そうですよねじゃあもう前半と後半では",
      "start": 1235.039,
      "duration": 7.041
    },
    {
      "text": "全然違う展開だったってことですねだから",
      "start": 1238.82,
      "duration": 6.84
    },
    {
      "text": "思い切っても行くしか食いに行ってみんな",
      "start": 1242.08,
      "duration": 6.099
    },
    {
      "text": "でこうやっぱリスクは当然あるんですけど",
      "start": 1245.66,
      "duration": 7.56
    },
    {
      "text": "ね行ったことでM勢いが乗ってきていい",
      "start": 1248.179,
      "duration": 8.36
    },
    {
      "text": "時間帯に先生じゃない1点目取れて",
      "start": 1253.22,
      "duration": 6.839
    },
    {
      "text": "一気にって感じですかねこれである意味だ",
      "start": 1256.539,
      "duration": 4.901
    },
    {
      "text": "よさ",
