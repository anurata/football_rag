      "duration": 4.48
    },
    {
      "text": "たね",
      "start": 1278.72,
      "duration": 4.5
    },
    {
      "text": "いやでもどういった展開だったのかなって",
      "start": 1280.58,
      "duration": 5.42
    },
    {
      "text": "気になったんでそうですね",
      "start": 1283.22,
      "duration": 5.36
    },
    {
      "text": "前半はめっちゃ強かったですけどね本当に",
      "start": 1286.0,
      "duration": 8.32
    },
    {
      "text": "そうかポストはとかあったんですよねはい",
      "start": 1288.58,
      "duration": 9.52
    },
    {
      "text": "最初ポストかな小林選手のあったんでまあ",
      "start": 1294.32,
      "duration": 7.04
    },
    {
      "text": "だから店員3点目とか入っても全然",
      "start": 1298.1,
      "duration": 5.52
    },
    {
      "text": "おかしくないというかそれぐらい東京",
