      "duration": 3.74
    },
    {
      "text": "ない",
      "start": 1116.66,
      "duration": 5.04
    },
    {
      "text": "しかもなんかMXが今回なんかあの5時",
      "start": 1118.48,
      "duration": 8.319
    },
    {
      "text": "まで3時キックオフで5時までで中継",
      "start": 1121.7,
      "duration": 6.12
    },
    {
      "text": "終了っていうのはもう決まってたんですよ",
      "start": 1126.799,
      "duration": 3.441
    },
    {
      "text": "もう決まったんですかどういう流れでも",
      "start": 1127.82,
      "duration": 5.04
    },
    {
      "text": "前半からその",
      "start": 1130.24,
      "duration": 6.96
    },
    {
      "text": "長沼選手のゴールでVAR入ったりとか",
      "start": 1132.86,
      "duration": 4.34
    },
    {
      "text": "6分って出たんです後半その瞬間に僕の",
