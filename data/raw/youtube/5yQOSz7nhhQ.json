      "duration": 7.821
    },
    {
      "text": "行って強さって出す行ったらやっぱり",
      "start": 1499.82,
      "duration": 6.9
    },
    {
      "text": "入れ替わられてガッて下がらない時もいけ",
      "start": 1503.62,
      "duration": 4.799
    },
    {
      "text": "ない時もあるじゃないですか",
      "start": 1506.72,
      "duration": 3.8
    },
    {
      "text": "戻れる",
      "start": 1508.419,
      "duration": 5.38
    },
    {
      "text": "すごいこの人はちょっと",
      "start": 1510.52,
      "duration": 4.139
    },
    {
      "text": "格違う",
      "start": 1513.799,
      "duration": 3.061
    },
    {
      "text": "ステージに来たぞっていうのちょっと見せ",
      "start": 1514.659,
      "duration": 3.88
    },
    {
      "text": "た試合でもあったかもしれないですこの人",
      "start": 1516.86,
      "duration": 4.98
    },
    {
      "text": "が今までではまあ普通にJ1でもやって",
      "start": 1518.539,
      "duration": 6.781
    },
    {
      "text": "るって感じだったんですけどもう多分俺が",
      "start": 1521.84,
      "duration": 5.719
    },
    {
      "text": "引っ張るぐらいの",
      "start": 1525.32,
      "duration": 5.78
    },
    {
      "text": "いいかもしれないですね",
      "start": 1527.559,
      "duration": 3.541
    },
