      "duration": 6.08
    },
    {
      "text": "言う感じでしたけどそんなに",
      "start": 1097.48,
      "duration": 4.86
    },
    {
      "text": "森繁選手も足痛めて変わったりとかあった",
      "start": 1103.039,
      "duration": 6.181
    },
    {
      "text": "んですよそうなんですねはいでも",
      "start": 1104.9,
      "duration": 9.44
    },
    {
      "text": "そんなにピンチがあれだったから",
      "start": 1109.22,
      "duration": 5.12
    },
    {
      "text": "盛り上がっちゃって分かんないんで覚えて",
