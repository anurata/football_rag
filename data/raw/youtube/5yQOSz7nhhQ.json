      "duration": 6.781
    },
    {
      "text": "今代理人今",
      "start": 1329.919,
      "duration": 6.64
    },
    {
      "text": "頑張って色もだいぶ今度あるんでそうか",
      "start": 1333.08,
      "duration": 6.78
    },
    {
      "text": "そういうことかはいそういう",
      "start": 1336.559,
      "duration": 5.901
    },
    {
      "text": "あれですね",
