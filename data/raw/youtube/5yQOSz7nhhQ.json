      "duration": 4.14
    },
    {
      "text": "昔のあれで",
      "start": 1170.6,
      "duration": 4.199
    },
    {
      "text": "昔のあれですねプロ野球的な感じですね",
      "start": 1172.1,
      "duration": 6.74
    },
    {
      "text": "そうそうなんですよこれはちょっと",
      "start": 1174.799,
      "duration": 6.62
    },
    {
      "text": "MX何かいつも",
      "start": 1178.84,
      "duration": 5.38
    },
    {
      "text": "MX2っていう番組逃げたりもする時も",
      "start": 1181.419,
      "duration": 4.781
    },
    {
      "text": "あるんですけど今回なんかそっちもやって",
      "start": 1184.22,
      "duration": 4.26
    },
    {
      "text": "たってことで",
      "start": 1186.2,
      "duration": 5.52
    },
    {
      "text": "そうだったんですねじゃあもういい",
      "start": 1188.48,
      "duration": 4.86
    },
    {
      "text": "雰囲気だったんじゃないですか",
      "start": 1191.72,
      "duration": 3.02
    },
    {
      "text": "終わった後",
      "start": 1193.34,
      "duration": 6.719
    },
    {
      "text": "最高ですよねもうクラウスキー",
      "start": 1194.74,
      "duration": 8.1
    },
    {
      "text": "監督からが出てきて",
      "start": 1200.059,
      "duration": 7.881
    },
    {
      "text": "一人で出てきてあるじゃないですか",
      "start": 1202.84,
      "duration": 5.1
    },
    {
      "text": "ちょっと早いなテンポ買ってダメ出しして",
