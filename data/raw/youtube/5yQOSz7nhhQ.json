      "text": "FC東京",
      "start": 1533.5,
      "duration": 5.2
    },
    {
      "text": "FC東京のキャプテンマークをそろそろ",
      "start": 1535.539,
      "duration": 5.321
    },
    {
      "text": "巻いても誰も不思議に思わないレベルに来",
      "start": 1538.7,
      "duration": 4.579
    },
    {
      "text": "てますそのぐらいの",
      "start": 1540.86,
      "duration": 6.6
    },
    {
      "text": "レベルにはいやもうなんか背中で",
      "start": 1543.279,
      "duration": 5.801
    },
    {
      "text": "背中が声もそうですけど",
      "start": 1547.46,
      "duration": 3.36
    },
    {
      "text": "プレーで",
      "start": 1549.08,
      "duration": 4.079
    },
    {
      "text": "チーム全体を勢いづかせたのはこの人なん",
      "start": 1550.82,
      "duration": 3.979
    },
    {
      "text": "じゃないかなと",
      "start": 1553.159,
      "duration": 3.981
    },
    {
      "text": "思いますね",
      "start": 1554.799,
      "duration": 5.081
    },
    {
      "text": "青森はまだでもそんぐらいやってました",
      "start": 1557.14,
      "duration": 4.779
    },
    {
      "text": "もんね中学生の時からやってたって言って",
      "start": 1559.88,
      "duration": 4.159
    },
    {
      "text": "ました",
      "start": 1561.919,
      "duration": 2.12
    },
    {
      "text": "年齢とかはもう気にせず行ってほしいです",
      "start": 1564.88,
      "duration": 7.36
    },
    {
      "text": "ねこれありえますさん日本トップ日本",
      "start": 1567.62,
      "duration": 7.5
    },
    {
      "text": "トップ代表ですか",
      "start": 1572.24,
      "duration": 5.66
    },
    {
      "text": "英代表ひょっとしたらほら",
      "start": 1575.12,
      "duration": 6.48
    },
    {
      "text": "でもパフォーマンス的にはねなんか選ばれ",
      "start": 1577.9,
      "duration": 7.18
    },
    {
      "text": "てもかもしれないですねちょっと",
      "start": 1581.6,
      "duration": 5.4
    },
    {
      "text": "楽しみですねはい",
      "start": 1585.08,
      "duration": 4.079
    },
    {
      "text": "わかりましたあとはいつまで特に行って",
      "start": 1587.0,
      "duration": 4.34
    },
    {
      "text": "くれるのかって",
      "start": 1589.159,
      "duration": 4.861
    },
    {
      "text": "そこはサポーターはみんな思ってることだ",
      "start": 1591.34,
      "duration": 4.86
    },
    {
      "text": "よね",
      "start": 1594.02,
      "duration": 2.18
