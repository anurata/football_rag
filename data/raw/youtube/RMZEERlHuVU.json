    {
      "text": "時が完全にルンバカ化するのでもう本当",
      "start": 634.279,
      "duration": 6.68
    },
    {
      "text": "時わずタイムに入ったかなと思っており",
      "start": 637.68,
      "duration": 5.159
    },
    {
      "text": "ますが、ま、そこでね、こうセカンド",
      "start": 640.959,
      "duration": 4.44
    },
    {
      "text": "ウォール取れて次に行くっていうような",
      "start": 642.839,
      "duration": 6.24
    },
    {
